{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "riscv64-debug",
            "type": "cppdbg",
            "request": "launch",
            "miDebuggerServerAddress": "127.0.0.1:1234",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "program": "${workspaceFolder}/target/riscv64gc-unknown-none-elf/debug/simplekernel",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "logging": {
                "engineLogging": "verbose"
            },
            "MIMode": "gdb",
            "preLaunchTask": "debug_riscv64"
        },
        {
            "name": "aarch64-debug",
            "type": "cppdbg",
            "request": "launch",
            "miDebuggerServerAddress": "127.0.0.1:1234",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "program": "${workspaceFolder}/target/aarch64-unknown-none-softfloat/debug/simplekernel",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "setupCommands": [
                {
                    "text": "add-symbol-file ${workspaceFolder}/target/firmware/aarch64/arm-trusted-firmware/qemu/release/bl1.elf"
                },
                {
                    "text": "add-symbol-file ${workspaceFolder}/target/firmware/aarch64/arm-trusted-firmware/qemu/release/bl2.elf"
                },
                {
                    "text": "add-symbol-file ${workspaceFolder}/target/firmware/aarch64/arm-trusted-firmware/qemu/release/bl31.elf"
                },
                {
                    "text": "add-symbol-file ${workspaceFolder}/target/firmware/aarch64/optee/optee_os/core/tee.elf"
                }
            ],
            "environment": [],
            "externalConsole": false,
            "logging": {
                "engineLogging": "verbose"
            },
            "MIMode": "gdb",
            "preLaunchTask": "debug_aarch64"
        }
    ]
}
