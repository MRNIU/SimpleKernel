{
	"name": "simplekernel-devcontainer",
	"build": {
		"dockerfile": "Dockerfile",
		"options": [
			"--tag",
			"simplekernel-devcontainer:latest"
		]
	},
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
	"workspaceFolder": "/workspace",
	"runArgs": [
		"--name",
		"simplekernel-devcontainer"
	],
	"remoteUser": "dev",
	"updateRemoteUserUID": true,
	"containerEnv": {
		"CARGO_HOME": "/usr/local/cargo",
		"RUSTUP_HOME": "/usr/local/rustup",
		"CARGO_TARGET_DIR": "${containerWorkspaceFolder}/target",
		"TMPDIR": "${containerWorkspaceFolder}/.tmp"
	},
	"postCreateCommand": "mkdir -p /workspace/target /workspace/.tmp && git config --global --add safe.directory /workspace && rustup show active-toolchain",
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"rust-analyzer.check.command": "clippy",
				"rust-analyzer.check.targets": [
					"riscv64gc-unknown-none-elf",
					"aarch64-unknown-none"
				]
			},
			"extensions": [
				"rust-lang.rust-analyzer"
			]
		}
	}
}
